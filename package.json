{
  "name": "@quxkit/billing-kit",
  "version": "0.2.0",
  "description": "Usage-based billing as a library, over a provider you choose.",
  "license": "Apache-2.0",
  "author": "BRETT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/billing-kit.git"
  },
  "homepage": "https://github.com/QuxKit/billing-kit#readme",
  "bugs": {
    "url": "https://github.com/QuxKit/billing-kit/issues"
  },
  "keywords": [
    "billing",
    "usage-based-billing",
    "metering",
    "usage-metering",
    "double-entry",
    "ledger",
    "invoicing",
    "subscriptions",
    "stripe",
    "paddle",
    "postgres",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "types": {
        "import": "./dist/providers/index.d.ts",
        "require": "./dist/providers/index.d.cts"
      },
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.cjs"
    },
    "./metering": {
      "types": {
        "import": "./dist/metering/index.d.ts",
        "require": "./dist/metering/index.d.cts"
      },
      "import": "./dist/metering/index.mjs",
      "require": "./dist/metering/index.cjs"
    },
    "./subscriptions": {
      "types": {
        "import": "./dist/subscriptions/index.d.ts",
        "require": "./dist/subscriptions/index.d.cts"
      },
      "import": "./dist/subscriptions/index.mjs",
      "require": "./dist/subscriptions/index.cjs"
    },
    "./entitlements": {
      "types": {
        "import": "./dist/entitlements/index.d.ts",
        "require": "./dist/entitlements/index.d.cts"
      },
      "import": "./dist/entitlements/index.mjs",
      "require": "./dist/entitlements/index.cjs"
    },
    "./invoices": {
      "types": {
        "import": "./dist/invoices/index.d.ts",
        "require": "./dist/invoices/index.d.cts"
      },
      "import": "./dist/invoices/index.mjs",
      "require": "./dist/invoices/index.cjs"
    },
    "./pg": {
      "types": {
        "import": "./dist/pg.d.ts",
        "require": "./dist/pg.d.cts"
      },
      "import": "./dist/pg.mjs",
      "require": "./dist/pg.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "billing-kit": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm run build && pnpm run test:all",
    "test:all": "tsx --test --test-concurrency=1 'test/*.test.ts' 'test/adversarial/*.test.ts' 'src/providers/tests/*.test.ts' 'src/metering/test/*.test.ts'",
    "test:unit": "pnpm run build && tsx --test --test-concurrency=1 'test/*.test.ts'",
    "test:adversarial": "tsx --test --test-concurrency=1 'test/adversarial/*.test.ts'",
    "test:providers": "tsx --test --test-concurrency=1 'src/providers/tests/*.test.ts'",
    "test:metering": "tsx --test --test-concurrency=1 'src/metering/test/*.test.ts'",
    "test:coverage": "pnpm run build && c8 pnpm run test:all",
    "test:pack": "tsx --test scripts/verify-pack.ts",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test && pnpm run test:pack"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "c8": "^12.0.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
