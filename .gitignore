# No trailing slash: with one, this matches a directory but not a *symlink*
# named node_modules, which is how a worktree usually gets its dependencies —
# and git then happily commits the link.
node_modules
dist/
.env
*.log

# `npm pack` writes here unless told otherwise, and verify-pack calls it.
*.tgz
coverage/

# Examples resolve the kit via link:../.. and keep their own install; one lockfile in the repo.
examples/*/pnpm-lock.yaml
